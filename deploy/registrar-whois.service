[Unit]
Description=Sandbar Registrar (WHOIS, port 43)
After=network-online.target registrar-web.service
Wants=network-online.target

[Service]
User=registrar
Group=registrar
EnvironmentFile=/etc/registrar/registrar.env
Environment=PYTHONPATH=/opt/registrar/app
WorkingDirectory=/opt/registrar/app
ExecStart=/usr/bin/python3 -m registrar.whois_server
Restart=on-failure
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
