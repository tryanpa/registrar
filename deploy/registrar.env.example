# /etc/registrar/registrar.env   (mode 640, owner root:registrar; setup-lxc.sh creates it for you)

# --- required -------------------------------------------------------------------------
# Signs login cookies. setup-lxc.sh generates a random one.
REGISTRAR_SECRET_KEY=change-me

# The DNS server that receives the updates, and the TSIG key made by install-bind-config.sh
DNS_SERVER=10.0.10.25
TSIG_KEY_NAME=registrar-key
TSIG_ALGORITHM=hmac-sha256
TSIG_SECRET=paste-the-secret-printed-by-install-bind-config.sh

# --- optional: remove the leading # to change a setting ---------------------------------
# IMPORTANT: keep comments on their own line. Never put "# text" after a value.

# Student names live only under these zones. "lab" and "sandbar.lab" are refused on purpose.
#TLDS=beach

# Name server shown in WHOIS, and the registrar's own hostname.
#NS_HOSTNAME=dns-dominica.sandbar.lab
#REGISTRAR_HOST=registrar.sandbar.lab
#REGISTRAR_NAME=Sandbar Registrar

# Student IPs must be inside these networks (comma separated CIDR).
#ALLOWED_NETWORKS=10.0.0.0/8

# Student IPs must NOT be inside these (comma separated CIDR; use /32 for a single host).
# The DNS server itself is always blocked, even if this is empty.
#DENIED_NETWORKS=10.0.50.0/24,10.0.10.0/24

# How many names each student may hold (pending + live).
#MAX_DOMAINS_PER_STUDENT=1

# Class code required on the sign-up page. Empty = anyone on the network can sign up.
#SIGNUP_CODE=

# Extra names students may not register, comma separated.
#RESERVED_NAMES=

#RECORD_TTL=300
#WHOIS_SHOW_EMAIL=false
#REGISTRAR_DB=/var/lib/registrar/registrar.db

# true = log DNS changes instead of sending them (for demos).
#DNS_DRY_RUN=false
